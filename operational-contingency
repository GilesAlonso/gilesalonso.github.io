                "cs-label": "Caso de Estudo",
                "cs-hero-title": "Contingência Operacional de Alta Disponibilidade",
                "cs-hero-subtitle": "Garantindo zero tempo de inatividade para secretarias de saúde durante falhas em sistemas federais externos.",
                
